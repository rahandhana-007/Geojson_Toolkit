{
  "id": "./",
  "name": "GeoJSON Toolkit — By AR",
  "short_name": "GeoJSON Toolkit",
  "description": "Toolkit lapangan untuk membuat, membaca, membandingkan, mengedit, dan mengganti nama file GeoJSON langsung di perangkat.",
  "lang": "id-ID",
  "dir": "ltr",
  "start_url": "./#maker",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#f2f2f2",
  "theme_color": "#111111",
  "categories": ["utilities", "productivity", "navigation"],
  "prefer_related_applications": false,
  "icons": [
    {
      "src": "assets/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "assets/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "assets/icons/maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Maker",
      "short_name": "Maker",
      "description": "Buat polygon dari titik GPS",
      "url": "./#maker",
      "icons": [{ "src": "assets/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Reader",
      "short_name": "Reader",
      "description": "Baca dan edit GeoJSON",
      "url": "./#reader",
      "icons": [{ "src": "assets/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Renamer",
      "short_name": "Renamer",
      "description": "Ganti nama file GeoJSON",
      "url": "./#renamer",
      "icons": [{ "src": "assets/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ]
}
